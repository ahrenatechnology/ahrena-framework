{
  "marketplace": {
    "name": "ahrena",
    "source": {
      "source": "github",
      "repo": "ahrenatechnology/ahrena-framework"
    }
  },
  "plugins": [
    "ahrena-engineering-development",
    "ahrena-engineering-delivery",
    "ahrena-engineering-frontend",
    "ahrena-engineering-backend",
    "ahrena-engineering-code-review",
    "ahrena-engineering-quality",
    "ahrena-engineering-fundamentals",
    "ahrena-engineering-security",
    "ahrena-contributing",
    "ahrena-foundation"
  ],
  "languages": {
    "python": {
      "plugin": "ahrena-engineering-python",
      "markers": [
        "pyproject.toml",
        "requirements.txt",
        "setup.py"
      ]
    },
    "typescript": {
      "plugin": "ahrena-engineering-typescript",
      "markers": [
        "tsconfig.json",
        "package.json"
      ]
    },
    "go": {
      "plugin": "ahrena-engineering-go",
      "markers": [
        "go.mod"
      ]
    },
    "rust": {
      "plugin": "ahrena-engineering-rust",
      "markers": [
        "Cargo.toml"
      ]
    },
    "terraform": {
      "plugin": "ahrena-engineering-terraform",
      "markers": [
        "main.tf",
        "versions.tf",
        "terraform.tf",
        ".terraform.lock.hcl"
      ]
    },
    "aws": {
      "plugin": "ahrena-engineering-aws",
      "markers": [
        "cdk.json",
        "samconfig.toml"
      ]
    },
    "gcp": {
      "plugin": "ahrena-engineering-gcp",
      "markers": [
        "cloudbuild.yaml",
        ".gcloudignore"
      ]
    },
    "azure": {
      "plugin": "ahrena-engineering-azure",
      "markers": [
        "azure.yaml",
        "host.json"
      ]
    },
    "devops": {
      "plugin": "ahrena-engineering-devops",
      "markers": [
        ".github/workflows/"
      ]
    }
  }
}
